# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API). Do NOT commit `.env.local`.

# Project URL, e.g. https://abcdefgh.supabase.co  (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key  (safe to expose to the browser; RLS protects your data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key  (SERVER ONLY — bypasses RLS; never expose to the browser).
# Used only by app/api/delete-account/route.js.
SUPABASE_SERVICE_ROLE_KEY=
